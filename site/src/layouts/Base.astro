---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { href, nav, ui, langs, links, type Lang, type PageId } from "../lib/i18n";

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other: Lang = lang === "hu" ? "en" : "hu";
const fullTitle = page === "home" ? t.name : `${title} · ${t.name}`;
const year = new Date().getFullYear();
const updated = new Intl.DateTimeFormat(lang === "hu" ? "hu-HU" : "en-GB", { dateStyle: "long" }).format(new Date());
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang} data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={t.name} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(page, l), Astro.site)} />)}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === "hu" ? "hu_HU" : "en_GB"} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <meta name="theme-color" content="#f8f6f1" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#151312" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    // Before first paint: colour theme (saved choice, else the system), and whether we
    // arrived from another page of this site (then the hero entrance is skipped).
    (() => {
      const root = document.documentElement;
      let theme = null;
      try { theme = localStorage.getItem("pw:theme"); } catch {}
      if (theme !== "light" && theme !== "dark") {
        theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      root.dataset.theme = theme;
      try {
        const ref = document.referrer && new URL(document.referrer);
        if (ref && ref.origin === location.origin && ref.pathname !== location.pathname) root.classList.add("pw-arrived");
      } catch {}
      // A language switch gets its own, softer page transition.
      addEventListener("pagereveal", (e) => {
        let kind = null;
        try { kind = sessionStorage.getItem("pw:vt"); sessionStorage.removeItem("pw:vt"); } catch {}
        if (!e.viewTransition || !kind) return;
        root.classList.add("pw-vt-" + kind);
        e.viewTransition.finished.finally(() => root.classList.remove("pw-vt-" + kind));
      });
    })();
  </script>
</head>
<body>
  <a class="pw-skip" href="#main">{t.skip}</a>
  <header class="pw-topbar" data-brand={page === "home" ? "hidden" : undefined}>
    <div class="pw-topbar-inner">
      <a class="pw-brand" href={href("home", lang)}>{t.name}</a>
      <nav class="pw-nav" aria-label={t.nav}>
        <ul>
          {nav.map((id) => (
            <li>
              <a href={href(id, lang)} aria-current={id === page ? "page" : undefined}>
                {id === page && <span class="pw-nav-pill" aria-hidden="true" />}
                <span>{t.pages[id]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="pw-actions">
        <a class="pw-btn pw-lang" href={href(page, other)} hreflang={other} lang={other}
           title={t.switchLang} aria-label={t.switchLang}>{t.otherLangCode}</a>
        <button type="button" class="pw-btn pw-theme-toggle" aria-pressed="false"
                aria-label={t.darkMode} data-label-dark={t.darkMode} data-label-light={t.lightMode} hidden>
          <Icon name="moon" class="pw-icon-moon" /><Icon name="sun" class="pw-icon-sun" />
        </button>
      </div>
    </div>
  </header>

  <main id="main" class="pw-main">
    <slot />
  </main>

  <footer class="pw-footer">
    <div class="pw-footer-inner">
      <p>© {year} {t.name} · <a href={`mailto:${links.email}`}>{links.email}</a></p>
      <p>{t.updated}: {updated}</p>
      <p><a href="#top">{t.backToTop} ↑</a></p>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Theme toggle: the new scheme opens as a circle from the button.
      const btn = document.querySelector(".pw-theme-toggle");
      const sync = () => {
        const dark = root.dataset.theme === "dark";
        btn.setAttribute("aria-pressed", String(dark));
        const label = dark ? btn.dataset.labelLight : btn.dataset.labelDark;
        btn.setAttribute("aria-label", label);
        btn.title = label;
      };
      btn.hidden = false;
      sync();
      btn.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const apply = () => { root.dataset.theme = next; sync(); };
        try { localStorage.setItem("pw:theme", next); } catch {}
        if (!document.startViewTransition || reduce) { apply(); return; }
        const r = btn.getBoundingClientRect();
        const x = r.left + r.width / 2, y = r.top + r.height / 2;
        root.style.setProperty("--pw-vt-x", x + "px");
        root.style.setProperty("--pw-vt-y", y + "px");
        root.style.setProperty("--pw-vt-r", Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + "px");
        root.classList.add("pw-vt-theme");
        document.startViewTransition(apply).finished.finally(() => root.classList.remove("pw-vt-theme"));
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("pw:theme"); } catch {}
        if (!saved) { root.dataset.theme = e.matches ? "dark" : "light"; sync(); }
      });

      // Language link: mark the next page transition as a language switch.
      const langLink = document.querySelector(".pw-lang");
      langLink.addEventListener("click", () => {
        try { sessionStorage.setItem("pw:vt", "lang"); } catch {}
        root.classList.add("pw-vt-lang");
      });
      addEventListener("pageshow", () => root.classList.remove("pw-vt-lang"));

      // Top bar: a hairline once the page scrolls; on the home page the name appears
      // in the bar only after the hero's large name has scrolled away.
      const topbar = document.querySelector(".pw-topbar");
      const sentinel = document.createElement("div");
      sentinel.setAttribute("aria-hidden", "true");
      sentinel.style.cssText = "position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none";
      document.body.prepend(sentinel);
      new IntersectionObserver(([e]) => { topbar.dataset.scrolled = String(!e.isIntersecting); }).observe(sentinel);
      const heroTitle = document.querySelector(".pw-hero .pw-title");
      if (heroTitle) {
        new IntersectionObserver(([e]) => { topbar.dataset.brand = e.isIntersecting ? "hidden" : "shown"; },
          { rootMargin: `-${topbar.offsetHeight}px 0px 0px 0px` }).observe(heroTitle);
      }

      // Keep the current page's link in view in the scrollable phone navigation.
      const current = document.querySelector('.pw-nav a[aria-current="page"]');
      const navEl = document.querySelector(".pw-nav");
      if (current && navEl.scrollWidth > navEl.clientWidth) {
        navEl.scrollLeft = current.offsetLeft - (navEl.clientWidth - current.offsetWidth) / 2;
      }

      // Sections reveal once as they scroll into view. Only sections that start below
      // the fold are hidden, so nothing visible on load ever disappears.
      if (!reduce && "IntersectionObserver" in window) {
        const pending = [...document.querySelectorAll(".pw-section")]
          .filter((s) => s.getBoundingClientRect().top > innerHeight * 0.92);
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.dataset.reveal = "shown";
            io.unobserve(e.target);
          }
        }, { rootMargin: "0px 0px -12% 0px" });
        for (const s of pending) { s.dataset.reveal = "pending"; io.observe(s); }
        const showTarget = () => {
          const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
          const s = el && el.closest(".pw-section");
          if (s) s.dataset.reveal = "shown";
        };
        addEventListener("hashchange", showTarget);
        addEventListener("beforeprint", () => pending.forEach((s) => (s.dataset.reveal = "shown")));
      }
    })();
  </script>
</body>
</html>
