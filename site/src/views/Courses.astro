---
// Courses page: the course groups from src/data/teaching.ts, then the Markdown body.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SubNav from "../components/SubNav.astro";
import CourseGroups from "../components/CourseGroups.astro";
import { type Lang } from "../lib/i18n";
import { loadPage } from "../lib/page";

interface Props { lang: Lang }
const { lang } = Astro.props;
const page = await loadPage(lang, "teaching-courses");
---
<Base lang={lang} page="teaching-courses" title={page.title} description={page.description}>
  <PageHead title={page.title} lead={page.lead} />
  <SubNav lang={lang} page="teaching-courses" />
  <CourseGroups lang={lang} />
  <page.Content />
</Base>
