---
// Teaching: the "Videos" tab. The heading stays "Teaching" on every teaching tab.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SubNav from "../components/SubNav.astro";
import { ui, type Lang } from "../lib/i18n";
import { videos } from "../data/videos";
import { loadPage } from "../lib/page";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const page = await loadPage(lang, "teaching");
---
<Base lang={lang} page="teaching" title={page.title} description={page.description}>
  <PageHead title={page.title} lead={page.lead} />
  <SubNav lang={lang} page="teaching" />
  <section class="pw-section" id="videos">
    <h2>{t.videos}</h2>
    <div class="pw-section-body pw-section-body--wide">
      <ul class="pw-videos">
        {videos.map((v) => (
          <li class="pw-video" id={v.id}>
            <a class="pw-video-thumb" href={v.href} aria-hidden="true" tabindex="-1">
              {v.thumb ? (
                <img src={`https://i.ytimg.com/vi/${v.thumb}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />
              ) : (
                <span class="pw-video-tile">{v.title[lang]}</span>
              )}
              <span class="pw-video-play"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
            </a>
            <h3><a href={v.href}>{v.title[lang]}</a></h3>
            <p>{v.text[lang]}</p>
            <p class="pw-video-links">
              <a href={v.href}>{t.watch}</a>
              {v.extra?.map((x) => <a href={x.href}>{x.label[lang]}</a>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <page.Content />
</Base>
