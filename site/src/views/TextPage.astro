---
// A page whose whole body is Markdown (teaching, contact, …).
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SubNav from "../components/SubNav.astro";
import { parent, type Lang, type PageId } from "../lib/i18n";
import { loadPage } from "../lib/page";

interface Props { lang: Lang; id: PageId }
const { lang, id } = Astro.props;
const page = await loadPage(lang, id);
// Subpages keep their section's heading (e.g. "Oktatás" on every teaching tab).
const head = parent[id] ? await loadPage(lang, parent[id]!) : page;
---
<Base lang={lang} page={id} title={parent[id] ? `${page.title} · ${head.title}` : page.title} description={page.description}>
  <PageHead title={head.title} lead={head.lead} />
  <SubNav lang={lang} page={id} />
  <page.Content />
</Base>
